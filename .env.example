# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/affinite?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# UploadThing
UPLOADTHING_TOKEN="your-uploadthing-token"
UPLOADTHING_SECRET="your-uploadthing-secret"

# K-Pay (paiements MoMo + Orange Money)
# Récupère ces clés sur https://admin.kpay.site
KPAY_BASE_URL="https://admin.kpay.site"
KPAY_API_KEY=""              # format kpay_test_xxx (sandbox) ou kpay_live_xxx
KPAY_SECRET_KEY=""
KPAY_WEBHOOK_SECRET=""       # ⚠️ OBLIGATOIRE EN PROD — sinon webhooks K-Pay rejetés
KPAY_CALLBACK_URL="http://localhost:3000/api/webhooks/kpay"

# Upstash Redis (rate limit distribué — OBLIGATOIRE EN PROD multi-instance)
# Inscription gratuite : https://upstash.com/ (free tier suffit)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Vercel Cron — secret pour authentifier les jobs cron (expire-boosts toutes les heures)
CRON_SECRET="generate-with-openssl-rand-base64-32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Affinité"

# URL du dashboard admin externe (repo Dashboard_AFFINITER)
# Pour le dev local, lance le dashboard admin sur le port 3100 :
#   NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3100"
NEXT_PUBLIC_DASHBOARD_URL="https://dashboard.affinité.com"

# URL du site public lui-même (utilisée par le dashboard admin et par ce
# repo pour ses propres liens externes en fallback)
NEXT_PUBLIC_AFFINITE_URL="https://affinité.com"
# Si vide → NEXT_PUBLIC_AFFINITE_URL + "/admin"
NEXT_PUBLIC_AFFINITE_ADMIN_URL=""

# Admin (utilisé pour le seed)
ADMIN_EMAIL="admin@affinité.com"
ADMIN_PASSWORD="ChangeMe123!"
